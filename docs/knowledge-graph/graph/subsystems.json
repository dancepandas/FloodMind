{
  "schema_version": "1.0",
  "nodes": [
    {
      "id": "sdk",
      "title": "SDK 公共入口",
      "layers": [
        "sdk"
      ],
      "paths": [
        "floodmind/__init__.py",
        "floodmind/agent/api.py",
        "floodmind/agent/sdk_events.py",
        "floodmind/agent/agent_registry.py"
      ],
      "responsibility": "宿主集成边界：创建 Agent、注入模型/工具/工作区，暴露 run/stream/chat/resume 与 committed 事件。",
      "kind": "subsystem"
    },
    {
      "id": "cli-host",
      "title": "CLI 与宿主入口",
      "layers": [
        "cli"
      ],
      "paths": [
        "main.py",
        "floodmind/cli.py",
        "floodmind/cli_interactive.py"
      ],
      "responsibility": "命令行任务、交互式终端、定时任务工具入口。",
      "kind": "subsystem"
    },
    {
      "id": "agent-core",
      "title": "Agent 执行核心",
      "layers": [
        "agent-core"
      ],
      "paths": [
        "floodmind/agent/native/"
      ],
      "responsibility": "显式状态机执行器、NativeFloodAgent 装配、消息/提示词构建、流式消费、压缩、工具加载、后台回顾。",
      "kind": "subsystem"
    },
    {
      "id": "runtime-contracts",
      "title": "运行时契约",
      "layers": [
        "runtime-contracts"
      ],
      "paths": [
        "floodmind/agent/runtime/contracts/"
      ],
      "responsibility": "Canonical Event/Part/Message、RunState、ToolSpec、权限/审批、Checkpoint、Sandbox、ChildThread、Workspace 等稳定数据契约。",
      "kind": "subsystem"
    },
    {
      "id": "runtime-kernel",
      "title": "Reducer 与投影",
      "layers": [
        "runtime-kernel"
      ],
      "paths": [
        "floodmind/agent/runtime/reducer.py"
      ],
      "responsibility": "事件日志到 RunState 的确定性归约，以及历史/消息投影。",
      "kind": "subsystem"
    },
    {
      "id": "runtime-services",
      "title": "运行时服务",
      "layers": [
        "runtime-services"
      ],
      "paths": [
        "floodmind/agent/runtime/services/"
      ],
      "responsibility": "Journal 权威源、工具事务、权限/ASK、路径/工作区、Checkpoint/Resume、沙箱、后台任务、子线程、产物、追踪与对账。",
      "kind": "subsystem"
    },
    {
      "id": "runtime-adapters",
      "title": "运行时适配器",
      "layers": [
        "runtime-adapters"
      ],
      "paths": [
        "floodmind/agent/runtime/adapters/"
      ],
      "responsibility": "把运行时服务暴露为 Flask/SSE 等宿主协议。",
      "kind": "subsystem"
    },
    {
      "id": "memory",
      "title": "记忆与会话",
      "layers": [
        "memory"
      ],
      "paths": [
        "floodmind/memory/",
        "floodmind/domain/memory/"
      ],
      "responsibility": "Journal 投影出的会话历史、core memory、任务经验树、巩固/回顾、语义存储、会话隔离。",
      "kind": "subsystem"
    },
    {
      "id": "tools",
      "title": "工具层",
      "layers": [
        "tools"
      ],
      "paths": [
        "floodmind/tools/"
      ],
      "responsibility": "AgentTool/ToolSpec 双契约、内置文件/记忆/命令工具、会话上下文注入。",
      "kind": "subsystem"
    },
    {
      "id": "skills",
      "title": "Skill 体系",
      "layers": [
        "skills"
      ],
      "paths": [
        "floodmind/skills/",
        "skills/"
      ],
      "responsibility": "SkillRegistry/Curator、SKILL.md 发现与 CRUD、内置技能包。",
      "kind": "subsystem"
    },
    {
      "id": "mcp",
      "title": "MCP 集成",
      "layers": [
        "mcp"
      ],
      "paths": [
        "floodmind/agent/mcp_client.py"
      ],
      "responsibility": "MCP 客户端池、连接/工具发现/热插拔、ToolSpec 构造。",
      "kind": "subsystem"
    },
    {
      "id": "model",
      "title": "模型与配置",
      "layers": [
        "model-config"
      ],
      "paths": [
        "floodmind/agent/native/model_client.py",
        "floodmind/agent/native/model_gateway.py",
        "floodmind/agent/native/providers/",
        "floodmind/config/"
      ],
      "responsibility": "统一模型门面、供应商 Codec/方言、流式解码、usage/reasoning、能力表、模型解析与 settings、回退链与子代理路由。",
      "kind": "subsystem"
    },
    {
      "id": "extension",
      "title": "扩展与辅助",
      "layers": [
        "extension",
        "agent-services",
        "common"
      ],
      "paths": [
        "floodmind/profile/",
        "floodmind/plugin/",
        "floodmind/agent/context_runtime.py",
        "floodmind/agent/guardrail.py",
        "floodmind/agent/handoff.py",
        "floodmind/common/"
      ],
      "responsibility": "人格/指导语、插件、上下文块、输入输出护栏、控制权移交与通用工具。",
      "kind": "subsystem"
    },
    {
      "id": "gateway",
      "title": "Gateway（HTTP/SSE 适配）",
      "layers": [
        "gateway"
      ],
      "paths": [
        "floodmind/gateway/"
      ],
      "responsibility": "活跃的 FastAPI/SSE 网关与内置单文件 UI，可选 Chainlit；进程内调用 SDK Agent。",
      "kind": "subsystem"
    },
    {
      "id": "tests",
      "title": "测试体系",
      "layers": [
        "tests"
      ],
      "paths": [
        "tests/"
      ],
      "responsibility": "按 P0-P8 契约、运行时服务、记忆、工具、模型供应商组织的回归套件。",
      "kind": "subsystem"
    },
    {
      "id": "evals",
      "title": "内部评测集",
      "layers": [
        "evals"
      ],
      "paths": [
        "evals/"
      ],
      "responsibility": "脚本化模型轨迹驱动真实执行器，覆盖冒烟、真实工具与安全/契约回归，作为 CI 门禁。",
      "kind": "subsystem"
    },
    {
      "id": "benchmarks",
      "title": "收益基线",
      "layers": [
        "benchmarks"
      ],
      "paths": [
        "benchmarks/"
      ],
      "responsibility": "single-agent 与 delegated 两种策略的对照任务集与判定规则，默认离线运行，--live 才调用模型。",
      "kind": "subsystem"
    },
    {
      "id": "tooling",
      "title": "工程脚本",
      "layers": [
        "tooling"
      ],
      "paths": [
        "scripts/"
      ],
      "responsibility": "冒烟、端到端验证与知识图谱生成。",
      "kind": "subsystem"
    }
  ],
