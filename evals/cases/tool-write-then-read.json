{
  "id": "tool-write-then-read",
  "tier": "tool",
  "tool_mode": "real",
  "description": "真实 Write + Read：写入 workspace 文件后读回，校验磁盘状态与上下文回填。",
  "user_text": "把敖江站水位写入报告，然后读回来确认。",
  "max_iterations": 6,
  "tools": {
    "Write": {},
    "Read": {}
  },
  "rounds": [
    {
      "events": [
        {
          "type": "tool_call_done",
          "tool_call": {
            "id": "call_write",
            "name": "Write",
            "arguments": {
              "file_path": "reports/summary.txt",
              "content": "敖江站水位 12.3 m\n"
            }
          }
        },
        {"type": "done", "terminal_reason": "tool_calls"}
      ]
    },
    {
      "events": [
        {
          "type": "tool_call_done",
          "tool_call": {
            "id": "call_read",
            "name": "Read",
            "arguments": {"file_path": "reports/summary.txt"}
          }
        },
        {"type": "done", "terminal_reason": "tool_calls"}
      ]
    },
    {
      "events": [
        {"type": "token", "content": "报告已写入并读取确认。"},
        {"type": "done", "terminal_reason": "stop"}
      ]
    }
  ],
  "expect": {
    "model_calls": 3,
    "tool_calls": ["Write", "Read"],
    "tool_statuses": ["completed", "completed"],
    "invalid_calls": 0,
    "prompt_contains": [
      {"call_index": 2, "contains": "12.3 m"}
    ],
    "workspace_contains": {
      "reports/summary.txt": "敖江站水位 12.3 m"
    },
    "final_output_contains": ["确认"]
  }
}
